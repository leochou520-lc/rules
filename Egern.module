name: "红果短剧去广告"
description: "基于 2026-11 实机抓包"
author: "leochou520-lc"
homepage: "https://github.com/leochou520-lc/rules"
icon: "shield.fill"

rules:
  # 白名单
  - domain_suffix:
      match: qznovelvod.com
      policy: DIRECT
  - domain_suffix:
      match: fqnovelvod.com
      policy: DIRECT
  - domain_suffix:
      match: id6.me
      policy: DIRECT
  - domain_suffix:
      match: qznovelpic.com
      policy: DIRECT
  - domain_suffix:
      match: fqnovelpic.com
      policy: DIRECT
  - domain_suffix:
      match: fqnovelstatic.com
      policy: DIRECT
  - domain_suffix:
      match: qznovelstatic.com
      policy: DIRECT

  # 拦截
  - domain_suffix:
      match: bytegecko.com
      policy: REJECT
  - domain_suffix:
      match: media-show.wanzi.com
      policy: REJECT
  - domain_suffix:
      match: ad.toutiao.com
      policy: REJECT
  - domain_suffix:
      match: effect.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: ichannel.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: zlink.toutiao.com
      policy: REJECT
  - domain_suffix:
      match: zlink.ugsdk.cn
      policy: REJECT
  - domain_keyword:
      match: pangolin
      policy: REJECT
  - domain_suffix:
      match: pglstatp-toutiao.com
      policy: REJECT
  - domain_suffix:
      match: pglstatp-toutiao-b.com
      policy: REJECT
  - domain_suffix:
      match: pangle.cn
      policy: REJECT
  - domain_regex:
      match: "^ads[0-9]*-normal\\..*\\.zijieapi\\.com$"
      policy: REJECT
  - domain_regex:
      match: "^polaris[0-9]*-.*\\..*\\.zijieapi\\.com$"
      policy: REJECT
  - domain_keyword:
      match: "-ad-sign.byteimg.com"
      policy: REJECT
  - domain_suffix:
      match: pstatp.com
      policy: REJECT
  - domain_suffix:
      match: mon.toutiaocloud.net
      policy: REJECT
  - domain_suffix:
      match: mon.toutiaocloud.com
      policy: REJECT
  - domain_suffix:
      match: i.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: i-lq.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: is.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: is-lq.snssdk.com
      policy: REJECT
  - domain_suffix:
      match: applog.fqnovel.com
      policy: REJECT
  - domain_suffix:
      match: log3-applog.fqnovel.com
      policy: REJECT
  - domain_suffix:
      match: log5-applog.fqnovel.com
      policy: REJECT
  - domain_suffix:
      match: dailygn.com
      policy: REJECT
  - domain_suffix:
      match: hbttl.cn
      policy: REJECT   
